TZ=Asia/Shanghai
PAPR_DB_PATH=/var/lib/papr/papr.sqlite3
PAPR_GENERATED_ROOT=/var/lib/papr/generated
PAPR_RATE_LIMIT_KEY_PATH=/var/lib/papr/rate-limit.key
PAPR_USER_ORIGINS=https://practice.example.com
PAPR_ADMIN_ORIGINS=https://admin.example.com
PAPR_COOKIE_SECURE=true
PAPR_PDF_NODE=/usr/local/bin/node
# Replace with chromium.executablePath() output after installation.
PAPR_PDF_BROWSER=/opt/papr/browsers/REPLACE_WITH_ACTUAL_PATH/chrome
PAPR_PDF_FONT=/opt/papr/fonts/NotoSansCJKsc-Regular.otf
PLAYWRIGHT_BROWSERS_PATH=/opt/papr/browsers
