{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "web/src/**/*.ts",
    "web/src/**/*.vue",
    "admin/src/**/*.ts",
    "admin/src/**/*.vue",
    "web/vite.config.ts",
    "admin/vite.config.ts",
    "frontend-shared/src/**/*.mts",
    "print/src/**/*.ts",
    "print/src/**/*.vue",
    "print/vite.config.ts"
  ]
}
